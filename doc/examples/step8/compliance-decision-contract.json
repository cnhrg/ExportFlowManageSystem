{
  "schema_version": 1,
  "additional_properties": false,
  "required": [
    "action_code",
    "result_code",
    "reason_code",
    "actor_reference",
    "decided_at",
    "decision_type",
    "decision_details"
  ],
  "optional": [
    "approver_reference",
    "evidence_references",
    "reason_text"
  ],
  "rules": [
    "通过决定result2必须独立approver_reference；application_reference仅引用同案件原申请",
    "holdReference为原action2事件号；关案不改变有效原因；多目标解除逐目标applied才完成",
    "所有源向量、集合、引用及证据分别依照公共§11和本步Proto闭合，不接收自由扩展JSON"
  ],
  "decision_details": {
    "assignment": {
      "action_code": 1,
      "result_codes": [
        1
      ],
      "required": [
        "assigned_to",
        "due_at",
        "reason"
      ],
      "optional": [],
      "additional_properties": false
    },
    "hold_decision": {
      "action_code": 2,
      "result_codes": [
        2,
        3
      ],
      "required": [
        "reason",
        "affected_contexts"
      ],
      "optional": [],
      "additional_properties": false
    },
    "gate_acknowledgement": {
      "action_code": 4,
      "result_codes": [
        1
      ],
      "required": [
        "decision_reference",
        "hold_reference",
        "phase"
