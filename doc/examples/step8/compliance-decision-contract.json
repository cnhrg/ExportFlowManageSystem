      "optional": [
        "target_context_code",
        "target_business_reference",
        "source_revision_reference",
        "source_event_reference"
      ],
      "additional_properties": false
    },
    "remedy": {
      "action_code": 3,
      "result_codes": [
        1
      ],
      "required": [
        "original_disposition_reference",
        "substantive_dispositions",
