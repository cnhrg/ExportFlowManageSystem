        "object_sets",
        "rule_version",
        "reason",
        "evidence_references"
      ],
      "optional": [],
      "additional_properties": false
    },
    "correction_decision": {
      "action_code": 6,
      "result_codes": [
        2,
        3
      ],
      "required": [
        "application_reference",
        "outcome",
        "source_version_vector",
        "object_sets",
        "rule_version",
        "invalidated_references",
        "reentry_node",
        "propagation_targets",
        "reason",
        "evidence_references"
      ],
      "optional": [],
      "additional_properties": false
    },
    "release_application": {
      "action_code": 7,
      "result_codes": [
        1
      ],
      "required": [
        "hold_reference",
        "source_version_vector",
        "object_sets",
        "rule_version",
        "substantive_dispositions",
        "evidence_references"
      ],
      "optional": [],
      "additional_properties": false
    },
    "release_decision": {
      "action_code": 8,
      "result_codes": [
        2,
        3
      ],
      "required": [
        "hold_reference",
        "application_reference",
        "validation_basis",
