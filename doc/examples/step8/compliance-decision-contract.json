  "field_types": {
    "assigned_to": "string",
    "due_at": "UTC datetime",
    "reason": "string",
    "decision_reference": "string",
    "hold_reference": "string",
    "phase": "enum received|applied",
    "target_context_code": "string",
    "target_business_reference": "string",
    "source_revision_reference": "string",
    "source_event_reference": "string",
    "original_disposition_reference": "string",
    "substantive_dispositions": "array<SourceReference>",
    "evidence_references": "array<FileRef>",
    "explanation": "string",
    "application_reference": "string",
    "outcome": "enum APPROVE|RETURN",
    "source_version_vector": "array<SQLSourceReference>",
    "object_sets": "array<{type:string,object_ids:array<string>,hash:sha256}>",
    "rule_version": "string",
    "original_node": "SourceReference",
    "affected_contexts": "array<AffectedContext>",
    "dependency_edges": "array<SourceReference>",
    "invalidated_references": "array<SourceReference>",
    "reentry_node": "SourceReference",
    "propagation_targets": "array<AffectedContext>",
    "validation_basis": "string",
    "money_difference_closure": "SourceReference|null (null only when no linked funds difference)",
    "scope": "string"
  }
}
