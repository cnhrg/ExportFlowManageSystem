      "action_code": 9,
      "result_codes": [
        2,
        3
      ],
      "required": [
        "application_reference",
        "scope",
        "source_version_vector",
        "object_sets",
        "evidence_references"
      ],
      "optional": [],
      "additional_properties": false
    }
