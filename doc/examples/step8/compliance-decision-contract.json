      "action_code": 4,
      "result_codes": [
        2,
        3
      ],
      "required": [
        "application_reference",
        "outcome",
        "reason",
        "source_version_vector",
        "object_sets",
        "evidence_references"
      ],
      "optional": [],
      "additional_properties": false
    },
    "correction_application": {
      "action_code": 5,
      "result_codes": [
        1
